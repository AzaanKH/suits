# Created or updated by `pnpm convex:dev`.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Clerk authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# Convex dashboard environment variable for Clerk auth provider.
CLERK_FRONTEND_API_URL=

# Stripe Elements and Checkout Sessions for authenticated one-time purchases.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_PROCESSING_SECRET=
# Keep false locally unless Stripe Tax has a real origin/head-office address.
STRIPE_AUTOMATIC_TAX_ENABLED=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# USPS Addresses 3.0 server-side validation.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Set to "test" to use https://apis-tem.usps.com. Defaults to production.
USPS_API_ENV=test
# Also set this value in the Convex dashboard.
USPS_VALIDATION_PROCESSING_SECRET=
